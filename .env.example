# Copie pra .env e preencha. O .env real nunca vai pro git (já tá no .gitignore).
# Só TIKTOK_USERNAME é obrigatório pra rodar com uma live real (npm run dev / pm2:start).
# O resto tem fallback seguro — não precisa preencher pra rodar, só pra ativar o recurso.

# Usuário TikTok que vai ficar ao vivo, sem @
TIKTOK_USERNAME=

# Portas locais (raramente precisa mudar)
HTTP_PORT=8080
WS_PORT=8787

# Webhook (Discord-compatible, espera {content: "..."}) pra alertas críticos:
# processo caiu, TikTok desconectado >5min, watchdog reiniciando o app.
ALERT_WEBHOOK_URL=

# obs-websocket v5 — só precisa se quiser o auto-refresh da Browser Source
# quando o render client cair. Ativar em OBS: Ferramentas > Configurações do WebSocket.
OBS_WS_URL=
OBS_WS_PASSWORD=
OBS_SOURCE_NAME=

# Watchdog (src/ops/watchdog.ts) — só precisa mudar se rodar watchdog separado
# do pm2:start (que já injeta HEALTH_URL/PM2_APP_NAME sozinho).
# HEALTH_URL=http://localhost:8080/health
# PM2_APP_NAME=reino-em-guerra
# WATCHDOG_INTERVAL_MS=15000

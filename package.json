{
  "name": "reino-em-guerra",
  "version": "0.1.0",
  "description": "Jogo interativo de live 24h no TikTok - Reino em Guerra",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:probe": "tsx src/probe.ts",
    "dev": "tsx watch src/index.ts",
    "dev:fake": "tsx src/devInjector.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "watchdog": "tsx src/ops/watchdog.ts",
    "loadtest": "tsx src/loadTest.ts",
    "balance": "tsx src/balanceSim.ts",
    "pm2:start": "npm run build && npx pm2 start ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:logs": "npx pm2 logs",
    "test": "vitest run"
  },
  "dependencies": {
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.18.0",
    "phaser": "^3.80.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "obs-websocket-js": "^5.0.8",
    "dotenv": "^18.0.6"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "tsx": "^4.19.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "vitest": "^2.1.1",
    "pm2": "^7.0.4"
  }
}
